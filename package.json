{
  "name": "tritetris",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TriTetris - competitive 3-player real-time Tetris over WebSockets (server-authoritative)",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "tsx src/server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test:engine": "tsx scripts/test-engine.ts",
    "test:e2e": "tsx scripts/e2e.ts",
    "test": "npm run test:engine && npm run test:e2e"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
